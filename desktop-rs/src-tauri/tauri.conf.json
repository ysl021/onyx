{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ONYX",
  "version": "0.9.5",
  "identifier": "app.onyx.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ONYX",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/mpv", "binaries/yt-dlp"],
    "resources": ["resources/mpv-NOTICE.txt"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "ru-RU"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ysl021/onyx/releases/download/desktop-latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBMjI5QjZGQTFBQ0Y3QkQKUldTOTk2eWhiNXNpeWtrcERLRU1FL0ZxaUNaV2dBNU5FMERCSElreVpDc1NRcUlmVElTK3FoK3QK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
